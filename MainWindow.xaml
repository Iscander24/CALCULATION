<Window x:Class="CALCULATION.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CALCULATION"
        xmlns:cust="clr-namespace:CALCULATION.View"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="500">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Margin" Value="10, 10, 10, 10"/>
            <Setter Property="FontSize" Value="50"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/> 
        </Grid.RowDefinitions>
        <cust:DecimalTextBox Text="{Binding InputString}"
                             Grid.ColumnSpan="4"
                             Margin="10, 10, 10 ,10"/>
        <Button Content="AC" Grid.Column="0" Grid.Row="1" Command="{Binding CommandAC}"/>
        <Button Content="1" Grid.Column="0" Grid.Row="2" Command="{Binding KeyboardNumber}" CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}" Focusable="False"/>
        <Button Content="2" Grid.Column="1" Grid.Row="2" Command="{Binding KeyboardNumber}" CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}" Focusable="False"/>
        <Button Content="3" Grid.Column="2" Grid.Row="2" Command="{Binding KeyboardNumber}" CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}" Focusable="False"/>
        <Button Content="4" Grid.Column="0" Grid.Row="3" Command="{Binding KeyboardNumber}" CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>
        <Button Content="5" Grid.Column="1" Grid.Row="3" Command="{Binding KeyboardNumber}" CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>
        <Button Content="6" Grid.Column="2" Grid.Row="3" Command="{Binding KeyboardNumber}" CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>
        <Button Content="7" Grid.Column="0" Grid.Row="4" Command="{Binding KeyboardNumber}" CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>
        <Button Content="8" Grid.Column="1" Grid.Row="4" Command="{Binding KeyboardNumber}" CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>
        <Button Content="9" Grid.Column="2" Grid.Row="4" Command="{Binding KeyboardNumber}" CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>
        <Button Content="0" Grid.Column="1" Grid.Row="5" Command="{Binding KeyboardNumber}" CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>
        <Button Content="." Grid.Column="2" Grid.Row="5" Command="{Binding KeyboardNumber}" CommandParameter="{Binding Content, RelativeSource={RelativeSource Self}}"/>
        <Button Content="+" Grid.Column="3" Grid.Row="1" Command="{Binding CommandAdd}"/>
        <Button Content="-" Grid.Column="3" Grid.Row="2" Command="{Binding CommandSubtract}"/>
        <Button Content="/" Grid.Column="3" Grid.Row="3" Command="{Binding CommandDivide}"/>
        <Button Content="*" Grid.Column="3" Grid.Row="4" Command="{Binding CommandMultiplicate}"/>
        <Button Content="=" Grid.Column="3" Grid.Row="5" Command="{Binding CommandResult}"/>

    </Grid> 
</Window>
